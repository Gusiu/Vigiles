# Copy to .env and change the passwords. .env is never committed.
# scripts/local_up.py creates .env from this file when it is missing.

# PostgreSQL superuser (local tests create and drop throwaway databases with it)
POSTGRES_PASSWORD=change-me-postgres
PG_ADMIN_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/postgres

# Application roles created by infra/postgres/init.sql
REGISTRY_DB_PASSWORD=change-me-registry
IMPORTER_DB_PASSWORD=change-me-importer
HUB_DB_PASSWORD=change-me-hub

# Registry: migrations run as the database owner
REGISTRY_DATABASE_URL=postgresql://registry_app:${REGISTRY_DB_PASSWORD}@localhost:5432/registry

# Importer
IMPORTER_DATABASE_URL=postgresql://importer:${IMPORTER_DB_PASSWORD}@localhost:5432/registry
IMPORTER_DATA_DIR=data
IMPORTER_POLL_INTERVAL_S=10

LOG_LEVEL=INFO
LOG_FORMAT=json
