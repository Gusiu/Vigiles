# Copy to .env and change the passwords. .env is never committed.
# scripts/local_up.py creates .env from this file when it is missing.

# PostgreSQL superuser (local tests create and drop throwaway databases with it)
POSTGRES_PASSWORD=change-me-postgres
PG_ADMIN_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/postgres

# Application roles created by infra/postgres/init.sql
REGISTRY_DB_PASSWORD=change-me-registry
IMPORTER_DB_PASSWORD=change-me-importer
HUB_DB_PASSWORD=change-me-hub

# Registry: migrations run as the database owner
REGISTRY_DATABASE_URL=postgresql://registry_app:${REGISTRY_DB_PASSWORD}@localhost:5432/registry

# Importer
IMPORTER_DATABASE_URL=postgresql://importer:${IMPORTER_DB_PASSWORD}@localhost:5432/registry
IMPORTER_DATA_DIR=data
IMPORTER_POLL_INTERVAL_S=10

LOG_LEVEL=INFO
LOG_FORMAT=json

# Authentication: static (4.0) | dev (local mode) | oidc (Keycloak, compose)
AUTH_MODE=dev
# Static bearer tokens of the service clients (AUTH_MODE=static)
SERVICE_TOKENS=svc-field-app=change-me-field-app-token,svc-registry=change-me-registry-token,svc-hub=change-me-hub-token
SESSION_SECRET=change-me-session-secret

# Service addresses
REGISTRY_URL=http://localhost:8001
FIELD_APP_URL=http://localhost:8002

# MQTT broker users (infra/mosquitto/acl)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_GW01_PASSWORD=change-me-gw01
MQTT_HUB_PASSWORD=change-me-hub-mqtt
MQTT_EXPLORER_PASSWORD=change-me-explorer

# Hub
HUB_DATABASE_URL=postgresql://hub_app:${HUB_DB_PASSWORD}@localhost:5432/hub

# Gateway simulator API (localhost only)
GATEWAY_API_KEY=change-me-gateway-key

# OAuth2 / OIDC (AUTH_MODE=dev: tools/dev_issuer, AUTH_MODE=oidc: Keycloak)
OIDC_ISSUER=http://127.0.0.1:8006
OIDC_JWKS_URL=http://127.0.0.1:8006/protocol/openid-connect/certs
OIDC_TOKEN_URL=http://127.0.0.1:8006/protocol/openid-connect/token
# Browser-facing base of the identity provider (login pages, AUTH_MODE=oidc)
OIDC_PUBLIC_URL=http://localhost:8080/realms/vigiles
OIDC_SECRET_SVC_HUB=change-me-svc-hub-secret
OIDC_SECRET_SVC_FIELD_APP=change-me-svc-field-app-secret
OIDC_SECRET_SVC_REGISTRY=change-me-svc-registry-secret
OIDC_UI_SECRET_REGISTRY=change-me-registry-ui-secret
OIDC_UI_SECRET_FIELD_APP=change-me-field-app-ui-secret
OIDC_UI_SECRET_HUB=change-me-hub-console-secret
# Password of the demo users in Keycloak (jan.technik, anna.kierownik, zarzadca.b1, admin)
DEMO_USER_PASSWORD=change-me-demo-password
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
