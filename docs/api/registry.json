  "components": {
    "schemas": {
      "ChangeIn": {
        "properties": {
          "change_id": {
            "type": "string",
            "format": "uuid",
            "title": "Change Id"
          },
          "entity": {
            "type": "string",
            "title": "Entity"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "base_rev": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Base Rev"
          },
          "patch": {
            "additionalProperties": true,
            "type": "object",
            "title": "Patch"
          }
        },
        "type": "object",
        "required": [
          "change_id",
          "entity",
          "id",
          "patch"
        ],
        "title": "ChangeIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IncidentIn": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "alarm_potwierdzony",
              "alarm_wstepny"
            ],
            "title": "Kind"
          },
          "site": {
            "type": "string",
            "title": "Site"
          },
          "zone": {
            "type": "string",
            "title": "Zone"
          },
          "detectors": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Detectors"
          },
          "first_at": {
            "type": "string",
            "format": "date-time",
            "title": "First At"
          },
          "decided_at": {
            "type": "string",
            "format": "date-time",
            "title": "Decided At"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "site",
          "zone",
          "detectors",
          "first_at",
          "decided_at"
        ],
        "title": "IncidentIn"
      },
      "PushIn": {
        "properties": {
          "changes": {
            "items": {
              "$ref": "#/components/schemas/ChangeIn"
            },
            "type": "array",
            "maxItems": 500,
            "title": "Changes"
          }
        },
        "type": "object",
        "required": [
          "changes"
        ],
        "title": "PushIn"
      },
      "ResolveIn": {
        "properties": {
          "choice": {
            "type": "string",
            "enum": [
              "server",
              "client",
              "custom"
            ],
            "title": "Choice"
          },
          "value": {
            "title": "Value"
          }
        },
        "type": "object",
        "required": [
          "choice"
        ],
        "title": "ResolveIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WorkOrderIn": {
        "properties": {
          "asset_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Asset Code"
          },
          "asset_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Asset Id"
          },
          "reason": {
            "type": "string",
            "enum": [
              "przeglad_okresowy",
              "usterka_urzadzenia",
              "czyszczenie",
              "brak_lacznosci"
            ],
            "title": "Reason"
          },
          "assigned_to": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Assigned To"
          },
          "due_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Due Date"
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          }
        },
        "type": "object",
        "required": [
          "reason"
        ],
        "title": "WorkOrderIn"
      }
    }
  }
}
