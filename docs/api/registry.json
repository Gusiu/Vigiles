    "/api/v1/conflicts": {
      "get": {
        "summary": "Get Conflicts",
        "operationId": "get_conflicts_api_v1_conflicts_get",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "open",
                    "resolved"
                  ],
