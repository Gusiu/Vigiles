{
  "realm": "vigiles",
  "enabled": true,
  "displayName": "Vigiles",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "loginWithEmailAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "technik",
        "description": "Technician: tasks and inspections"
      },
      {
        "name": "kierownik",
        "description": "Manager: work orders, conflicts, imports, console"
      },
      {
        "name": "zarzadca",
        "description": "Building manager: read only"
      },
      {
        "name": "admin",
        "description": "Administrator, including dead letters"
      },
      {
        "name": "svc-hub",
        "description": "Service: integration hub"
      },
      {
        "name": "svc-field-app",
        "description": "Service: field app"
      },
      {
        "name": "svc-registry",
        "description": "Service: registry"
      }
    ]
  },
  "clients": [
    {
      "clientId": "registry-ui",
      "name": "registry-ui",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${OIDC_UI_SECRET_REGISTRY}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8001/*"
      ],
      "webOrigins": [
        "http://localhost:8001"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "audience-registry-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "registry-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "field-app-ui",
      "name": "field-app-ui",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${OIDC_UI_SECRET_FIELD_APP}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
